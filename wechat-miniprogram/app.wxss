/* 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', SimSun, sans-serif;
}

/* 通用按钮样式 */
button {
  border-radius: 8rpx;
}

button[type="primary"] {
  background-color: #1E88E5;
}

button[type="primary"][disabled] {
  background-color: #BBDEFB;
}

/* 通用卡片样式 */
.card {
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  margin-bottom: 20rpx;
}

/* 通用加载样式 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #666;
  font-size: 28rpx;
}

/* 通用空状态样式 */
.empty {
  text-align: center;
  padding: 100rpx 20rpx;
  color: #999;
  font-size: 28rpx;
}

/* 价格涨跌样式 */
.price-up {
  color: #E53935;
}

.price-down {
  color: #43A047;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  background: #E3F2FD;
  color: #1E88E5;
}