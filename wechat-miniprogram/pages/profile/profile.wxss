.container { padding: 20rpx; background-color: #f5f5f5; min-height: 100vh; }
.user-card { background: white; border-radius: 16rpx; padding: 40rpx 30rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1); display: flex; align-items: center; }
.user-avatar { margin-right: 20rpx; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; }
.user-info { flex: 1; }
.nickname { display: block; font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 5rpx; }
.username { font-size: 24rpx; color: #666; }
.login-btn { background: #1E88E5; color: white; border: none; border-radius: 8rpx; padding: 15rpx 30rpx; font-size: 26rpx; }
.menu-section { background: white; border-radius: 16rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1); }
.menu-title { font-size: 28rpx; font-weight: bold; color: #333; padding: 25rpx 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.menu-item { display: flex; align-items: center; padding: 25rpx 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 30rpx; margin-right: 15rpx; }
.menu-text { font-size: 28rpx; color: #333; flex: 1; }
.menu-arrow { font-size: 24rpx; color: #999; }
.menu-value { font-size: 26rpx; color: #666; flex: 1; text-align: right; }
.action-section { margin-top: 40rpx; display: flex; flex-direction: column; gap: 20rpx; }
.logout-btn, .clear-btn { border: none; border-radius: 8rpx; padding: 25rpx; font-size: 28rpx; }
.logout-btn { background: #E53935; color: white; }
.clear-btn { background: #FF9800; color: white; }
.footer { text-align: center; margin-top: 60rpx; padding: 20rpx; }
.footer-text { display: block; font-size: 22rpx; color: #999; margin-bottom: 10rpx; }