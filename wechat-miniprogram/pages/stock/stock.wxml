<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">股票筛选</text>
    <text class="page-subtitle">估值优先、安全边际</text>
  </view>

  <!-- AI分析操作栏 -->
  <view class="ai-actions" wx:if="{{stocks.length > 0}}">
    <view class="ai-header">
      <text class="ai-title">AI分析</text>
      <text class="ai-count">已选 {{selectedCount}} 只</text>
    </view>
    <view class="ai-buttons">
      <button class="ai-btn" bindtap="analyzeSelected">分析所选</button>
      <button class="ai-btn" bindtap="analyzeAll">分析全部</button>
    </view>
  </view>

  <!-- 股票列表 -->
  <scroll-view class="stock-list" scroll-y>
    <view class="stock-item" wx:for="{{stocks}}" wx:key="id">
      <view class="stock-top-row">
        <view class="stock-checkbox">
          <checkbox value="{{item.code}}" bindchange="onStockSelect" checked="{{selectedStocks[item.code]}}" catchtap="preventBubble"/>
        </view>
        <view class="stock-main-info" bindtap="viewDetail" data-code="{{item.code}}">
          <view class="stock-name">{{item.name}}</view>
          <view class="stock-code">{{item.code}}</view>
        </view>
        <view class="stock-price-info">
          <text class="price">¥{{item.price}}</text>
          <text class="change {{item.change >= 0 ? 'up' : 'down'}}">
            {{item.change >= 0 ? '+' : ''}}{{item.change}}%
          </text>
        </view>
      </view>
      <view class="stock-metrics-row">
        <text class="metric">PE: {{item.pe}}</text>
        <text class="metric">市值: {{item.marketCap}}</text>
      </view>
      <view class="mock-tag" wx:if="{{item._mock}}">模拟</view>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && stocks.length > 0}}">
      <text>- 已加载全部 {{stocks.length}} 条 -</text>
    </view>
  </scroll-view>

  <!-- 分页控制器 -->
  <view class="pagination" wx:if="{{stocks.length > 0}}">
    <button class="page-btn" bindtap="loadPrevPage" disabled="{{currentPage <= 1}}">上一页</button>
    <view class="page-indicator">
      <text>第 {{currentPage}} / {{totalPages}} 页</text>
      <text>共 {{totalItems}} 条</text>
    </view>
    <button class="page-btn" bindtap="loadNextPage" disabled="{{currentPage >= totalPages}}">下一页</button>
  </view>
</view>