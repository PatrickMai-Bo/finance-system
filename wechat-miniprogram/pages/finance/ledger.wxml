<view class="container">
  <!-- 页面标题和添加按钮 -->
  <view class="page-header">
    <view>
      <text class="page-title">记账</text>
      <text class="page-subtitle">收支明细，清晰掌控</text>
    </view>
    <button class="add-btn" size="mini" bindtap="showAddModal">添加</button>
  </view>

  <!-- 记账列表 -->
  <scroll-view class="ledger-list" scroll-y>
    <view class="ledger-item" wx:for="{{ledgerList}}" wx:key="id">
      <view class="ledger-info">
        <text class="ledger-date">{{item.date}}</text>
        <text class="ledger-desc">{{item.description}}</text>
      </view>
      <view class="ledger-details">
        <text class="ledger-category">{{getCategoryName(item.category)}}</text>
        <text class="ledger-amount {{item.type === 'income' ? 'income' : 'expense'}}">
          {{item.type === 'income' ? '+' : '-'}}¥{{item.amount}}
        </text>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{ledgerList.length === 0}}">
      <text>暂无记账记录</text>
      <button class="empty-btn" bindtap="showAddModal">开始记账</button>
    </view>
  </scroll-view>

  <!-- 汇总卡片 -->
  <view class="summary-card" wx:if="{{summary}}">
    <view class="summary-title">本月汇总</view>
    <view class="summary-items">
      <view class="summary-item">
        <text class="summary-label">收入</text>
        <text class="summary-value income">+¥{{summary.totalIncome}}</text>
      </view>
      <view class="summary-item">
        <text class="summary-label">支出</text>
        <text class="summary-value expense">-¥{{summary.totalExpense}}</text>
      </view>
      <view class="summary-item">
        <text class="summary-label">结余</text>
        <text class="summary-value net">¥{{summary.netCashflow}}</text>
      </view>
    </view>
  </view>

  <!-- 添加记账模态框 -->
  <view class="modal" wx:if="{{showModal}}">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">添加记账</text>
        <text class="modal-close" bindtap="hideAddModal">×</text>
      </view>
      <view class="modal-body">
        <picker mode="date" value="{{newRecord.date}}" bindchange="onDateChange">
          <view class="form-item">
            <text class="form-label">日期</text>
            <text class="form-value">{{newRecord.date}}</text>
            <text class="form-arrow">▼</text>
          </view>
        </picker>
        
        <picker range="{{['income', 'expense']}}" value="{{typeIndex}}" bindchange="onTypeChange">
          <view class="form-item">
            <text class="form-label">类型</text>
            <text class="form-value">{{typeIndex === 0 ? '收入' : '支出'}}</text>
            <text class="form-arrow">▼</text>
          </view>
        </picker>
        
        <view class="form-item">
          <text class="form-label">金额</text>
          <input type="digit" placeholder="输入金额" value="{{newRecord.amount}}" bindinput="onAmountInput" />
        </view>
        
        <view class="form-item">
          <text class="form-label">描述</text>
          <input placeholder="输入描述" value="{{newRecord.description}}" bindinput="onDescriptionInput" />
        </view>
        
        <picker range="{{incomeCategories}}" wx:if="{{typeIndex === 0}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="form-item">
            <text class="form-label">分类</text>
            <text class="form-value">{{incomeCategories[categoryIndex]}}</text>
            <text class="form-arrow">▼</text>
          </view>
        </picker>
        
        <picker range="{{expenseCategories}}" wx:if="{{typeIndex === 1}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="form-item">
            <text class="form-label">分类</text>
            <text class="form-value">{{expenseCategories[categoryIndex]}}</text>
            <text class="form-arrow">▼</text>
          </view>
        </picker>
      </view>
      <view class="modal-footer">
        <button class="modal-btn cancel" bindtap="hideAddModal">取消</button>
        <button class="modal-btn submit" bindtap="submitRecord">确定</button>
      </view>
    </view>
  </view>
</view>