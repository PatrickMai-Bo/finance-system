.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}
.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}
.page-subtitle {
  font-size: 24rpx;
  color: #666;
}
.add-btn {
  background: #1E88E5;
  color: white;
  border-radius: 8rpx;
  font-size: 24rpx;
}
.holding-summary {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}
.summary-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.summary-row:last-child {
  margin-bottom: 0;
}
.summary-item {
  flex: 1;
  text-align: center;
}
.summary-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.summary-value {
  font-size: 32rpx;
  font-weight: bold;
}
.asset {
  color: #43A047;
}
.liability {
  color: #E53935;
}
.net {
  color: #1E88E5;
}
.income {
  color: #43A047;
}
.expense {
  color: #E53935;
}
.holding-list {
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin: 20rpx 0 15rpx;
}
.holding-item {
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}
.holding-info {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}
.holding-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-right: 15rpx;
}
.holding-type {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}
.holding-type.asset {
  background: #E8F5E9;
  color: #43A047;
}
.holding-type.liability {
  background: #FFEBEE;
  color: #E53935;
}
.holding-details {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.holding-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.holding-cashflow {
  font-size: 26rpx;
}
.holding-note {
  font-size: 24rpx;
  color: #999;
}
.empty {
  text-align: center;
  padding: 80rpx 20rpx;
  color: #999;
}
.empty-btn {
  margin-top: 20rpx;
  background: #1E88E5;
  color: white;
  border-radius: 8rpx;
  font-size: 26rpx;
}
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-content {
  background: white;
  border-radius: 16rpx;
  width: 85%;
  max-height: 80%;
  overflow-y: auto;
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.modal-close {
  font-size: 40rpx;
  color: #999;
}
.modal-body {
  padding: 30rpx;
}
.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #333;
}
.form-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.form-arrow {
  font-size: 20rpx;
  color: #999;
}
.form-item input {
  flex: 1;
  font-size: 28rpx;
}
.modal-footer {
  display: flex;
  padding: 30rpx;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  border-radius: 8rpx;
  font-size: 28rpx;
}
.cancel {
  background: #f5f5f5;
  color: #666;
}
.submit {
  background: #1E88E5;
  color: white;
}