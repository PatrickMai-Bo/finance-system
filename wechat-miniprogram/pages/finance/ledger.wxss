.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.page-subtitle {
  font-size: 24rpx;
  color: #666;
}

.add-btn {
  background: #1E88E5;
  color: white;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.ledger-list {
  margin-bottom: 20rpx;
}

.ledger-item {
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ledger-info {
  flex: 1;
}

.ledger-date {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.ledger-desc {
  font-size: 28rpx;
  color: #333;
}

.ledger-details {
  text-align: right;
}

.ledger-category {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.ledger-amount {
  font-size: 32rpx;
  font-weight: bold;
}

.income {
  color: #43A047;
}

.expense {
  color: #E53935;
}

.summary-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.summary-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.summary-items {
  display: flex;
  justify-content: space-between;
}

.summary-item {
  text-align: center;
  flex: 1;
}

.summary-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 30rpx;
  font-weight: bold;
}

.net {
  color: #1E88E5;
}

.empty {
  text-align: center;
  padding: 80rpx 20rpx;
  color: #999;
}

.empty-btn {
  margin-top: 20rpx;
  background: #1E88E5;
  color: white;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  background: white;
  border-radius: 16rpx;
  width: 85%;
  max-height: 80%;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 0 10rpx;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-label {
  width: 150rpx;
  font-size: 28rpx;
  color: #333;
}

.form-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.form-arrow {
  font-size: 20rpx;
  color: #999;
}

.form-item input {
  flex: 1;
  font-size: 28rpx;
}

.modal-footer {
  display: flex;
  padding: 30rpx;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.cancel {
  background: #f5f5f5;
  color: #666;
}

.submit {
  background: #1E88E5;
  color: white;
}