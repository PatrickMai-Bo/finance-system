.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.date {
  font-size: 24rpx;
  color: #666;
}

.finance-card, .section-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.finance-items {
  display: flex;
  justify-content: space-between;
}

.finance-item {
  text-align: center;
  flex: 1;
}

.finance-item .label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.finance-item .value {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #1E88E5;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.more {
  font-size: 24rpx;
  color: #1E88E5;
}

.fund-list, .stock-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.fund-item, .stock-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.fund-item:last-child, .stock-item:last-child {
  border-bottom: none;
}

.fund-name, .stock-name {
  font-size: 28rpx;
  color: #333;
}

.stock-code {
  font-size: 22rpx;
  color: #666;
  margin-left: 10rpx;
}

.fund-yield, .change {
  font-size: 26rpx;
  font-weight: bold;
}

.up {
  color: #E53935;
}

.down {
  color: #43A047;
}

.stock-info {
  display: flex;
  align-items: center;
}

.stock-price {
  text-align: right;
}

.price {
  display: block;
  font-size: 28rpx;
  color: #333;
}

.market-note {
  background: #FFF3E0;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}

.note-text {
  font-size: 24rpx;
  color: #E65100;
}

.decision-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.decision-item {
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.decision-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.decision-desc {
  font-size: 26rpx;
  color: #666;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #666;
}