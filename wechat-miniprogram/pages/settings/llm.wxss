.container { padding: 20rpx; background-color: #f5f5f5; min-height: 100vh; }
.page-header { margin-bottom: 30rpx; }
.page-title { display: block; font-size: 40rpx; font-weight: bold; color: #333; margin-bottom: 8rpx; }
.page-subtitle { font-size: 26rpx; color: #666; }
.config-item { background: white; border-radius: 16rpx; padding: 30rpx; margin-bottom: 15rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1); }
.config-item.active { border: 2rpx solid #1E88E5; }
.config-info { margin-bottom: 15rpx; }
.config-name-row { display: flex; align-items: center; margin-bottom: 10rpx; }
.config-name { font-size: 32rpx; font-weight: bold; color: #333; margin-right: 15rpx; }
.config-active { font-size: 22rpx; color: #1E88E5; background: #E3F2FD; padding: 4rpx 12rpx; border-radius: 4rpx; }
.config-model { font-size: 26rpx; color: #666; margin-bottom: 8rpx; }
.config-url { font-size: 24rpx; color: #999; word-break: break-all; }
.config-actions { display: flex; gap: 10rpx; }
.action-btn { font-size: 24rpx; border-radius: 6rpx; padding: 10rpx 15rpx; }
.activate-btn { background: #1E88E5; color: white; }
.test-btn { background: #FF9800; color: white; }
.delete-btn { background: #f5f5f5; color: #E53935; }
.add-section { margin-top: 30rpx; }
.add-btn { background: #43A047; color: white; border-radius: 8rpx; font-size: 28rpx; }
.modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 999; }
.modal-content { background: white; border-radius: 16rpx; width: 85%; max-height: 80%; overflow-y: auto; }
.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.modal-title { font-size: 32rpx; font-weight: bold; color: #333; }
.modal-close { font-size: 40rpx; color: #999; }
.modal-body { padding: 30rpx; }
.form-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.form-label { width: 180rpx; font-size: 28rpx; color: #333; }
.form-item input { flex: 1; font-size: 28rpx; }
.form-item switch { flex: 1; }
.modal-footer { display: flex; padding: 30rpx; gap: 20rpx; }
.modal-btn { flex: 1; border-radius: 8rpx; font-size: 28rpx; }
.cancel { background: #f5f5f5; color: #666; }
.submit { background: #1E88E5; color: white; }